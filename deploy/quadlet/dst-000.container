# Managed by dst-server: room container v1
[Unit]
Description=Don't Starve Together dst-000

[Container]
Image="quay.io/wh2099/dst-server:latest"
Pull=never
RunInit=true
Exec=/usr/local/bin/dst-server agent --cluster /cluster
StopTimeout=360
AutoUpdate=registry
Volume=/srv/dst/000:/cluster:idmap=uids=0-1000-1;gids=0-1000-1
Volume=/srv/dst/000/mods:/install/mods:idmap=uids=0-1000-1;gids=0-1000-1
PublishPort=30000:10999/udp
PublishPort=30001:27016/udp
PublishPort=30002:11000/udp
PublishPort=30003:27017/udp
Environment="DST_SERVER_CLUSTER_NAME=dst-000"
Environment="DST_SERVER_PUBLISHED_PORTS={\"cave\":30002,\"forest\":30000}"
Environment="DST_SERVER_TELEMETRY_PROFILE=history"
Environment="OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://10.255.255.254:4317"
Environment="OTEL_METRICS_EXPORTER=none"
Environment="OTEL_TRACES_EXPORTER=none"

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=900
TimeoutStopSec=420

[Install]
WantedBy=default.target
