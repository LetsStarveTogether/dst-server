import builtins
from collections.abc import Awaitable, Sequence
from os import PathLike
from pathlib import Path
from typing import Any, Literal

class DstError(Exception):
    code: str
    details: Any

class Client:
    @staticmethod
    def connect(path: str | PathLike[str]) -> Awaitable[Client]: ...
    def call(
        self,
        method: str,
        arguments: dict[str, Any] | None = None,
        *,
        shard: str | None = None,
        timeout: float | None = None,
    ) -> Awaitable[Any]: ...
    def describe(self) -> Awaitable[dict[str, Any]]: ...
    def subscribe(
        self, kind: Literal["logs", "lifecycle", "events"]
    ) -> Awaitable[Subscription]: ...
    def close(self) -> Awaitable[None]: ...

class Subscription:
    def next(self, max_items: int = 512) -> Awaitable[dict[str, Any]]: ...
    def close(self) -> Awaitable[None]: ...

def describe(scope: Literal["room", "shard"] = "room") -> list[dict[str, Any]]: ...
def inspect(directory: str | PathLike[str]) -> dict[str, Any]: ...
def run_cli(arguments: list[str]) -> int: ...

class Configuration:
    def __init__(
        self, model: str, values: dict[str, Any] | None = None, **fields: Any
    ) -> None: ...
    @property
    def model(self) -> str: ...
    def dump(
        self, *, defaults: bool = False, secrets: bool = False
    ) -> dict[str, Any]: ...
    def schema(self) -> dict[str, Any]: ...
    def replace(self, **changes: Any) -> Configuration: ...
    @staticmethod
    def parse(model: str, source: str, *, kind: str | None = None) -> Configuration: ...
    @staticmethod
    def load(
        directory: str | PathLike[str],
        *,
        world_kinds: dict[str, str] | None = None,
        level_kinds: dict[str, str] | None = None,
    ) -> Configuration: ...
    def render(self, *, multi_shard: bool = False) -> str: ...
    def files(self) -> dict[str, str]: ...
    def save(
        self, directory: str | PathLike[str], *, replace_permissions: bool = False
    ) -> list[Path]: ...
    @staticmethod
    def compose(parts: Sequence[Configuration]) -> Configuration: ...
    def build(
        self,
        *,
        token: str = "",
        cluster_key: str | None = None,
        settings: Configuration | dict[str, Any] | None = None,
    ) -> Configuration: ...

class Room:
    def __init__(self, value: dict[str, Any] | None = None, **fields: Any) -> None: ...
    @property
    def number(self) -> int: ...
    @property
    def cluster(self) -> Configuration: ...
    def dump(
        self, *, defaults: bool = False, secrets: bool = False
    ) -> dict[str, Any]: ...
    @staticmethod
    def schema() -> dict[str, Any]: ...
    def get(self, pointer: str = "") -> Any: ...
    def edit(self, pointer: str, value: Any = None, *, unset: bool = False) -> Room: ...
    def edit_many(
        self,
        changes: Sequence[tuple[str, Any]] | None = None,
        *,
        unset: Sequence[str] | None = None,
    ) -> Room: ...

class RoomStore:
    def __init__(
        self,
        root: str | PathLike[str],
        *,
        quadlet_dir: str | PathLike[str] | None = None,
    ) -> None: ...
    @property
    def root(self) -> Path: ...
    def path(self, room_number: int) -> Path: ...
    def numbers(self) -> builtins.list[int]: ...
    def load(self, room_number: int) -> Room: ...
    def list(self) -> builtins.list[Room]: ...
    def save(self, room: Room) -> builtins.list[Path]: ...
    def save_policy(self, room: Room) -> None: ...

def configuration_schema(model: str) -> dict[str, Any]: ...
def template_names() -> list[str]: ...
def preset_names() -> list[str]: ...
def preset(name: str) -> Configuration: ...
def room_numbers() -> list[int]: ...
