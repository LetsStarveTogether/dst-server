def room_name(room_number: int) -> str: ...
def room_schedule(room_number: int) -> tuple[str, int, int] | None: ...
def build_bundle(
    source: str | PathLike[str], output: str | PathLike[str]
) -> dict[str, Any]: ...
def verify_bundle(
    path: str | PathLike[str], *, source: str | PathLike[str] | None = None
