def render_lua_literal(value: Any) -> str: ...

class Host:
    def __init__(
        self,
        root: str | PathLike[str],
        quadlet_dir: str | PathLike[str],
        *,
        systemctl: str | PathLike[str] | None = None,
        journalctl: str | PathLike[str] | None = None,
        user: bool = False,
        command_timeout: float = 30.0,
        port_start: int = 30000,
        port_end: int = 65535,
    ) -> None: ...
    @property
    def rooms(self) -> RoomStore: ...
    def units(self, number: int) -> builtins.list[str]: ...
    def list(self) -> Awaitable[builtins.list[dict[str, Any]]]: ...
    def load(self, number: int) -> Awaitable[Room]: ...
    def create(self, definition: Room) -> Awaitable[Room]: ...
    def edit(self, definition: Room) -> Awaitable[Room]: ...
    def edit_fields(
        self, number: int, changes: builtins.list[tuple[str, Any]], unset: Sequence[str]
    ) -> Awaitable[Room]: ...
    def operate(self, number: int, request: dict[str, Any]) -> Awaitable[Any]: ...
    def batch(
        self, numbers: Sequence[int], request: dict[str, Any]
    ) -> Awaitable[builtins.list[dict[str, Any]]]: ...
    def provision(
        self, definitions: Sequence[Room]
    ) -> Awaitable[builtins.list[dict[str, Any]]]: ...
    def connect(self, number: int) -> Awaitable[Client]: ...
    def journal(
        self, numbers: Sequence[int], request: dict[str, Any]
    ) -> Awaitable[dict[str, Any]]: ...
    def follow_journal(
        self, numbers: Sequence[int], request: dict[str, Any]
    ) -> Awaitable[JournalStream]: ...

class KleiClient:
    def __init__(
        self,
        access_token: str | None = None,
        *,
        endpoints: dict[str, str] | None = None,
        request_timeout: float = 30.0,
        connect_timeout: float = 10.0,
        max_response_bytes: int = 33_554_432,
        lobby_concurrency: int = 8,
        room_concurrency: int = 24,
    ) -> None: ...
    def get_latest_build(self, version_type: str = "release") -> Awaitable[int]: ...
    def get_versions(self) -> Awaitable[list[dict[str, Any]]]: ...
    def get_regions(self) -> Awaitable[list[str]]: ...
    def lobby(
        self, region: str, platform: str = "Steam"
    ) -> Awaitable[list[dict[str, Any]]]: ...
    def room(self, row_id: str, region: str) -> Awaitable[dict[str, Any] | None]: ...
    def get_lobbies(
        self,
        regions: Sequence[str] | None = None,
        platforms: Sequence[str] | None = None,
    ) -> Awaitable[list[dict[str, Any]]]: ...
    def get_rooms(
        self, rooms: list[dict[str, Any]]
    ) -> Awaitable[list[dict[str, Any]]]: ...
    def discover_rooms(self) -> Awaitable[dict[str, Any]]: ...

class LogProcessError(RuntimeError):
    command: list[str]
    returncode: int
    diagnostics: str
    diagnostics_truncated: bool

class JournalCursorError(RuntimeError):
    cursor: str

class JournalLogs:
    def __init__(
        self,
        executable: str | PathLike[str],
        max_record_bytes: int,
        max_output_bytes: int,
    ) -> None: ...
    def query(
        self,
        units: Sequence[str] | None,
        request: dict[str, Any],
        completion_timeout: float,
    ) -> Awaitable[dict[str, Any]]: ...
    def follow(
        self, units: Sequence[str] | None, request: dict[str, Any]
    ) -> Awaitable[JournalStream]: ...

class JournalStream:
    @property
    def pid(self) -> int: ...
    @property
    def diagnostics(self) -> str: ...
    @property
    def diagnostics_truncated(self) -> bool: ...
    def next(self) -> Awaitable[dict[str, Any] | None]: ...
    def close(self) -> Awaitable[None]: ...

class NetdataLogs:
    def __init__(
        self,
        executable: str | PathLike[str],
        stock_config: str | PathLike[str],
        config: str | PathLike[str],
        max_concurrency: int,
        max_record_bytes: int,
        max_output_bytes: int,
    ) -> None: ...
    def query(
        self, request: dict[str, Any], completion_timeout: float
    ) -> Awaitable[dict[str, Any]]: ...

def event_schema() -> dict[str, Any]: ...
def validate_event(value: object) -> dict[str, Any]: ...

class ClusterArchive:
    def __init__(self, filename: str, stream: Any) -> None: ...
    @property
    def filename(self) -> str: ...
    @property
    def stream(self) -> Any: ...
    def close(self) -> None: ...
    def save(self, path: str | PathLike[str]) -> Awaitable[None]: ...
    def start_upload(
        self,
        *,
        bucket: str | None = None,
        endpoint: str | None = None,
        region: str | None = None,
        access_key_id: str | None = None,
        secret_access_key: str | None = None,
        session_token: str | None = None,
        object_prefix: str = "",
        url_prefix: str | None = None,
    ) -> ArchiveUpload: ...

class ArchiveUpload:
    def wait(self) -> Awaitable[dict[str, Any]]: ...
    def cancel(self) -> Awaitable[None]: ...

def export_archive(
    host: Host,
